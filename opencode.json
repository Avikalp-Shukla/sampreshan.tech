{
  "mcp": {
    "servers": {
      "git": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-server-git",
          "--repository",
          "/Users/avikalpshukla/ShivBodh-Projects/sampreshan-tech"
        ]
      },
      "github": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
        }
      }
    }
  }
}