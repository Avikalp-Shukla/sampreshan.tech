{
  "$schema": "https://app.kilo.ai/config.json",

  "provider": {
    "b": {
      "options": {
        "apiKey": "sk-canmbr2jyis9fkq46k8dec0c037mejhk",
        "baseURL": "https://api.b.ai/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "cost": { "input": 0, "output": 0 },
          "contextWindow": 64000,
          "isFree": true
        },
        "deepseek-v4-flash-vision-exp": {
          "name": "DeepSeek V4 Flash Vision",
          "cost": { "input": 0, "output": 0 },
          "contextWindow": 64000,
          "isFree": true,
          "supportsVision": true
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "cost": { "input": 1.32, "output": 1.32 },
          "contextWindow": 64000
        }
      }
    }
  },

  "model": "b/deepseek-v4-flash",
  "subagent_model": "b/deepseek-v4-flash",

  "permission": { "bash": "allow" },
  "web_search": true,
  "sandbox": { "enabled": true },

  "indexing": {
    "enabled": true,
    "model": "ollama/nomic-embed-text",
    "vectorStore": "qdrant",
    "provider": "ollama"
  },

  "experimental": {
    "batch_tool": true,
    "image_generation": true,
    "native_notebook_tools": true,
    "openTelemetry": true,
    "continue_loop_on_deny": true
  },

  "agent": { "explore": { "hidden": false } },

  "share": "auto",
  "disabled_providers": [],
  "remote_control": true,
  "mcp": {
    "github": {
      "enabled": true
    }
  }
}
