{
  "name": "sampreshan.tech WordPress",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "WordPress development server",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "EditorConfig.EditorConfig"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "php.validate.executablePath": "/usr/local/bin/php"
      }
    }
  },
  "postCreateCommand": "if [ -f composer.json ]; then composer install --no-interaction; fi",
  "remoteUser": "vscode"
}
